# Database - Render PostgreSQL
DATABASE_URL=postgresql://user:password@host.render.com:5432/database?schema=public&sslmode=require

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# Toss Payments
TOSS_SECRET_KEY=your_toss_secret_key
TOSS_CLIENT_KEY=your_toss_client_key

# Google Cloud Vision
GOOGLE_VISION_API_KEY=your_google_vision_api_key

# Server
PORT=3000
NODE_ENV=development

# Frontend URL - Vercel
FRONTEND_URL=https://drinkpaire.vercel.app
# Gemini API (무료 - https://ai.google.dev에서 발급)
GOOGLE_GENERATIVE_AI_KEY=your_gemini_api_key_here
